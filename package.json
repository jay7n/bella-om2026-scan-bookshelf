{
  "name": "bookshelf-scanner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "start:production": "next start -H 0.0.0.0 -p 3000",
    "build:prod": "next build",
    "tmux:start": "bash scripts/tmux-saoshu.sh start",
    "tmux:stop": "bash scripts/tmux-saoshu.sh stop",
    "tmux:restart": "bash scripts/tmux-saoshu.sh restart",
    "tmux:attach": "bash scripts/tmux-saoshu.sh attach",
    "tmux:status": "bash scripts/tmux-saoshu.sh status",
    "tmux:logs": "bash scripts/tmux-saoshu.sh logs",
    "bg:start": "bash scripts/bg-saoshu.sh start",
    "bg:stop": "bash scripts/bg-saoshu.sh stop",
    "bg:restart": "bash scripts/bg-saoshu.sh restart",
    "bg:status": "bash scripts/bg-saoshu.sh status",
    "bg:logs": "bash scripts/bg-saoshu.sh logs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2"
  }
